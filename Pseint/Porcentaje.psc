Algoritmo Porcentaje
	//Construir un pseudocódigo que permita ingresar
	//un número, si el número es mayor de 500, se debe
	//calcular y mostrar en pantalla el 18% de este.
	
	Definir numero,resultado Como Real;
	Escribir "ingrese un numero ";
	Leer numero;
	
	//Proceso 
	Si numero > 500 Entonces;
		resultado <- numero * (18/100);//0.18
		Escribir "El 18%es:",resultado
		
		
	FinSi
	
	
FinAlgoritmo
